node_modules/

# Выгрузки ФНС — это личные чеки: адреса, покупки, фискальные признаки.
# В публичный репозиторий они не едут, на сервер попадают через scripts/deploy.sh --data
api/data/fns_out/
api/data/*.db
api/data/*.db-shm
api/data/*.db-wal

# Сессия интернет-банка — это доступ к счетам. Никогда не в репозиторий
api/data/tbank-*

# Пароли, ключи, локальные переменные окружения
.env
.env.local
*.htpasswd

# Доступ к Открытым API ФНС: письмо с мастер-токеном и SDK.
# Токен — это доступ от нашего имени, в репозиторий он не едет.
docs/fns/token/

# локальные настройки Claude Code
.claude/

# Сборка приложения для Android
build/
