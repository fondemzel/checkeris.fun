<?xml version="1.0" encoding="utf-8"?>
<!--
  Чекер для Android. Оболочка вокруг checkeris.fun/m: весь интерфейс — сайт, поэтому
  обновления не требуют переустановки приложения. Родной код нужен для того, чего
  браузер не умеет: вход в банк на устройстве и загрузка операций в фоне.
-->
<!-- Номер версии подставляет сборщик из client/android/version.json -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.checkeris.app">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Камера: сканирование QR с чеков идёт в WebView -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Фоновая загрузка операций банка: задание переживает перезагрузку телефона -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Куда приложение умеет отправлять приглашения: мессенджеры и почта -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="tg" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="whatsapp" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="mailto" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    </queries>

    <application
        android:label="Чекер"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ссылки Чекера открываются в приложении, а не в браузере: приглашения
                 в бюджет и подтверждение входа из бота -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="checkeris.fun" android:pathPrefix="/m" />
                <data android:scheme="https" android:host="checkeris.fun" android:pathPrefix="/tg.html" />
            </intent-filter>
        </activity>
        <service
            android:name=".BankJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Окно входа в интернет-банк: обычный браузер, данные вводит человек -->
        <activity
            android:name=".BankLoginActivity"
            android:exported="false"
            android:label="Вход в Т-Банк"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
