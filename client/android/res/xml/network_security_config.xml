<?xml version="1.0" encoding="utf-8"?>
<!--
  С августа 2026 года tbank.ru работает на сертификате НУЦ Минцифры (Russian Trusted Root CA).
  Android ему не доверяет, и без этой настройки приложение не достучится до банка.
  Доверие — только для доменов Т-Банка, не для всего интернета: остальные сайты
  проверяются, как обычно, системными сертификатами.
  Корневой сертификат — с gu-st.ru (Госуслуги), отпечаток SHA-256
  D2:6D:2D:02:31:B7:C3:9F:92:CC:73:85:12:BA:54:10:35:19:E4:40:5D:68:B5:BD:70:3E:97:88:CA:8E:CF:31
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">tbank.ru</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/mincifry_root" />
        </trust-anchors>
    </domain-config>
</network-security-config>
